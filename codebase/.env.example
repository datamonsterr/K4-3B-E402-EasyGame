# Copy to codebase/.env. Values below are examples, never real secrets.
# Public app URL: local http://localhost:3000; hosted https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: https://supabase.com/dashboard/project/_/settings/api
# Local URL after npm run db:start: http://127.0.0.1:54321
# EasyGame hosted URL: https://wgitdkpmkaohpkdjxlhz.supabase.co
# Leave both blank to run the synthetic preview without a database.
NEXT_PUBLIC_SUPABASE_URL=https://wgitdkpmkaohpkdjxlhz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (legacy local service_role JWT also supported).
# Get local keys using npx supabase status; never prefix this key NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server scheduler bearer secret: generate with openssl rand -hex 32
# Also configure this in Supabase Vault for scheduled HTTP requests.
CRON_SECRET=

# CLI/CI only. Prefer GitHub environment secrets; the app does not consume these.
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Project reference: https://supabase.com/dashboard/project/_/settings/general
SUPABASE_PROJECT_REF=wgitdkpmkaohpkdjxlhz
# Database password/reset: https://supabase.com/dashboard/project/_/settings/database
SUPABASE_DB_PASSWORD=
# Vercel access token: https://vercel.com/account/settings/tokens
VERCEL_TOKEN=
# Run vercel link from codebase/; values are in ignored codebase/.vercel/project.json.
# Project/team settings: https://vercel.com/dashboard
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
